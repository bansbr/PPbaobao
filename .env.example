# 复制为 .env 仅作参考；本地可直接用环境变量，Docker 请在 compose 的 environment 中设置
# ---------------------------------------------------------------------------
# 以下两项是「镜像构建参数」，仅 docker build / docker compose --build 时生效，
# 不会写入容器环境变量。国内 NAS 拉不到 Docker Hub / npm 时取消注释并换成可达源：
# NODE_IMAGE=node:22-alpine
# NPM_REGISTRY=https://registry.npmjs.org
# 例：NODE_IMAGE=docker.1ms.run/library/node:22-alpine
#     NPM_REGISTRY=https://registry.npmmirror.com
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# 数据库文件所在目录（本地默认 ./data，Docker 默认 /app/data）
# DATA_DIR=/app/data
# 如需指定单个数据库文件路径（优先级高于 DATA_DIR）
# DB_PATH=/app/data/baby-journal.db
TZ=Asia/Shanghai

# 初始系统管理员（仅首次启动、且库中尚无任何管理员时生效，之后改这里不会覆盖已有账号）
# 默认值就是 admin / 123456；部署到局域网强烈建议改成强密码
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please
